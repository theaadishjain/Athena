# Copy to backend/.env and fill in the keys.

# ── AI model ─────────────────────────────────────────────
# Option A (default): Google AI Studio key -> https://aistudio.google.com/apikey
# Free tier works; note Google may use free-tier requests to improve its products.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Backup model used when LLM_MODEL is overloaded (503) or rate-limited (429).
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Faster model for whole-file summaries and flashcards (long input). In tests on a
# 60-page PDF: ~6s with flash-lite vs ~16s with 3.8-flash, same citation accuracy.
LLM_DOCUMENT_MODEL=gemini-3.5-flash-lite
# Option B: OpenRouter key -> https://openrouter.ai/keys
# (remove the three lines above, then set:)
# OPENROUTER_API_KEY=
# LLM_MODEL=google/gemini-2.5-flash
#
# Optional: thinking effort (low/medium/high). Empty = low on Google's endpoint.
LLM_REASONING_EFFORT=
# Parallel model calls for long documents. Keep low (2-3) on free tiers.
LLM_MAX_CONCURRENCY=3

# https://dashboard.clerk.com -> API Keys (same app as the frontend)
CLERK_SECRET_KEY=
# Optional hardening: your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# When set, tokens must have exactly this issuer.
CLERK_ISSUER=
# Optional: origins allowed in the token's `azp` claim (comma separated). Defaults to CORS_ORIGINS.
CLERK_AUTHORIZED_PARTIES=

# Local defaults. Docker / Railway override these with /data paths.
MEMPALACE_PATH=~/.mempalace/palace
MEMPALACE_COLLECTION=studyco
MEMORY_TOP_K=3
DATABASE_URL=sqlite+aiosqlite:///./studyco.db

# Comma separated origins of the frontend
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Upload limit for /summarize, and how many earlier chat messages the model sees
MAX_UPLOAD_MB=10
CHAT_HISTORY_MESSAGES=10
